  "fslogix": {
    "fileSizeGiB": 2,
    "tests": [
      { "key": "rr.qd1",   "args": "-b4K -r -o1 -t1 -w0 -d{d} -W3 -C2 -Sh -L -Z1M -Rxml",   "measures": [ { "id": "fsl.rr.qd1.p50", "metric": "readLatencyP50", "unit": "ms", "better": "lower" }, { "id": "fsl.rr.qd1.p99", "metric": "readLatencyP99", "unit": "ms", "better": "lower" } ] },
      { "key": "rw.qd1",   "args": "-b4K -r -o1 -t1 -w100 -d{d} -W3 -C2 -Sh -L -Z1M -Rxml", "measures": [ { "id": "fsl.rw.qd1.p50", "metric": "writeLatencyP50", "unit": "ms", "better": "lower" }, { "id": "fsl.rw.qd1.p99", "metric": "writeLatencyP99", "unit": "ms", "better": "lower" } ] },
      { "key": "mix.qd32", "args": "-b4K -r -o8 -t4 -w30 -d{d} -W3 -C2 -Sh -L -Z1M -Rxml",  "measures": [ { "id": "fsl.mix.qd32", "metric": "iops", "unit": "IOPS", "better": "higher" } ] },
      { "key": "seq.read", "args": "-b1M -si -o8 -t1 -w0 -d{d} -W3 -C2 -Sh -Rxml",          "measures": [ { "id": "fsl.seq.read", "metric": "readMiBps", "unit": "MiB/s", "better": "higher" } ] },
      { "key": "seq.write", "args": "-b1M -si -o8 -t1 -w100 -d{d} -W3 -C2 -Sh -Z1M -Rxml",  "measures": [ { "id": "fsl.seq.write", "metric": "writeMiBps", "unit": "MiB/s", "better": "higher" } ] }
    ],
    "vhd": { "sizeGiB": 2, "writeMB": 200, "writeMBQuick": 50, "parallel": 5 }
  },
  "capacity": { "maxMinutes": 30, "thresholdPercent": 50 },
  "run": { "runs": 3, "unstableCvPercent": 10, "deltaThresholdPercent": 10, "preconditions": { "minUptimeMinutes": 5, "maxCpuPercent": 10, "idleSecondsFull": 60, "idleSecondsQuick": 10, "minFreeGiB": 10, "updateWaitMinutes": 10 } },
