<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Packages only from nuget.org, whatever the user or machine configuration says (issue #19). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>