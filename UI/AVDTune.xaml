                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="PillBlock" Style="{DynamicResource Pill}" Padding="10,2" VerticalAlignment="Center"><TextBlock x:Name="TxtBlockPill" FontSize="12" FontWeight="SemiBold"/></Border>
