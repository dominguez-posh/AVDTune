                                                    <TextBlock x:Name="TxtWmMatch" Grid.Row="2" Grid.ColumnSpan="2" Style="{DynamicResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                    <TextBlock Text="Text" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                    <TextBox x:Name="TxtWmText" Grid.Row="3" Grid.Column="1" Padding="8,6" Margin="0,0,0,8" AutomationProperties.Name="Watermark text"/>
                                                    <TextBlock Text="Colour" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                                        <TextBox x:Name="TxtWmColor" Width="110" Padding="8,6" AutomationProperties.Name="Colour as #RRGGBB"/>
                                                        <Border x:Name="BoxWmSwatch" Width="28" Height="28" CornerRadius="4" Margin="10,0,0,0" BorderThickness="1" BorderBrush="{DynamicResource Border}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Opacity (10-100 %)" Grid.Row="5" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                    <TextBox x:Name="TxtWmOpacity" Grid.Row="5" Grid.Column="1" Width="110" HorizontalAlignment="Left" Padding="8,6" Margin="0,0,0,8" AutomationProperties.Name="Opacity in percent"/>
                                                    <TextBlock Text="Font size (8-96)" Grid.Row="6" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                    <TextBox x:Name="TxtWmSize" Grid.Row="6" Grid.Column="1" Width="110" HorizontalAlignment="Left" Padding="8,6" Margin="0,0,0,8" AutomationProperties.Name="Font size"/>
                                                    <TextBlock Text="Corner" Grid.Row="7" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                    <ComboBox x:Name="CmbWmCorner" Grid.Row="7" Grid.Column="1" Width="170" HorizontalAlignment="Left" Margin="0,0,0,8" AutomationProperties.Name="Corner of every monitor"/>
                                                    <TextBlock Text="Distance (0-500 px)" Grid.Row="8" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                    <TextBox x:Name="TxtWmMargin" Grid.Row="8" Grid.Column="1" Width="110" HorizontalAlignment="Left" Padding="8,6" Margin="0,0,0,8" AutomationProperties.Name="Distance from the edge in pixels"/>
                                                </Grid>
                                                <CheckBox x:Name="ChkWmHeadless" Content="Start without any console window flash (conhost --headless)" Margin="0,6,0,2"/>
                                                <TextBlock Text="powershell.exe -WindowStyle Hidden opens its console window before it hides it, so one can flash for a moment at logon. conhost --headless avoids that on current Windows 10 and 11, but Microsoft does not document it and some security tools flag it. Off by default." Style="{DynamicResource Hint}" TextWrapping="Wrap" Margin="24,0,0,8"/>
                                                <CheckBox x:Name="ChkWmMs" Content="Also switch on the Microsoft QR code watermark (connection ID in every remote session)" Margin="0,6,0,2"/>
                                                <TextBlock Text="For forensics: a photo of the screen can be traced to a session. Once it is on, only clients that support watermarking can connect (the others fail with an unspecific error); RemoteApp is not marked." Style="{DynamicResource Hint}" TextWrapping="Wrap" Margin="24,0,0,8"/>
                                                <TextBlock x:Name="TxtWmErrors" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <Button x:Name="BtnWmSave" Content="Save settings" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{DynamicResource CardBox}" Background="{DynamicResource Card}" Padding="16" VerticalAlignment="Top">
                                            <StackPanel>
                                                <TextBlock Text="Preview" Style="{DynamicResource CardTitle}"/>
                                                <Border x:Name="BoxWmDesktop" Width="480" Height="270" Margin="0,10,0,0" Background="#FF3E5C8A" ClipToBounds="True" AutomationProperties.Name="Preview of one monitor">
                                                    <Canvas x:Name="CanvasWm">
                                                        <Rectangle x:Name="RectWmTaskbar" Width="480" Height="8" Fill="#CC101820" Canvas.Top="262"/>
                                                        <TextBlock x:Name="TxtWmPreview" FontWeight="Bold" Canvas.Left="0" Canvas.Top="0" AutomationProperties.Name="Watermark preview"/>
                                                    </Canvas>
                                                </Border>
                                                <TextBlock x:Name="TxtWmPreviewNote" Style="{DynamicResource Hint}" TextWrapping="Wrap" Width="480" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="On this master" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel x:Name="PanelWmItems" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="TxtWmNotes" Style="{DynamicResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ============ Benchmark ============ -->
                        <Grid x:Name="PageBenchmark" Visibility="Collapsed">
                            <ScrollViewer Style="{DynamicResource PageScroll}">
                                <StackPanel Margin="40,32,40,28" MaxWidth="1000" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Benchmark" Style="{DynamicResource PageTitle}"/>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{DynamicResource Subtitle}" Text="Measures CPU, memory, OS disk, remote display and network of this master and compares it with the baseline. Nothing on the master is changed; Windows Update and the indexer are paused during the run and started again."/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                            <Button x:Name="BtnBenchQuick" Content="Quick run" Margin="0,0,8,0" AutomationProperties.Name="Start a quick benchmark"/>
                                            <Button x:Name="BtnBenchFull" Style="{DynamicResource PrimaryButton}" Content="Full run" AutomationProperties.Name="Start a full benchmark"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="BoxBenchCrash" Visibility="Collapsed" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource ErrorBg}" Padding="20,14">
                                        <StackPanel>
                                            <TextBlock Text="A benchmark did not end properly" FontWeight="SemiBold" Foreground="{DynamicResource Danger}"/>
                                            <TextBlock x:Name="TxtBenchCrash" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <Button x:Name="BtnBenchRepair" Content="Restore Windows Update and the indexer" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="TxtBenchState" Style="{DynamicResource Hint}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="BarBench" Height="6" Minimum="0" Maximum="100" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.Name="Benchmark progress"/>
                                    <Border x:Name="BoxBenchProvisional" Visibility="Collapsed" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource WarningBg}" Padding="20,12">
                                        <TextBlock x:Name="TxtBenchProvisional" TextWrapping="Wrap"/>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtBenchTitle" Text="Result" Style="{DynamicResource CardTitle}"/>
                                            <TextBlock x:Name="TxtBenchScore" FontSize="32" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="TxtBenchMeta" Style="{DynamicResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <StackPanel x:Name="PanelBenchCats" Margin="0,12,0,0"/>
                                            <TextBlock x:Name="TxtBenchNotes" Style="{DynamicResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="Earlier runs" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel x:Name="PanelBenchHistory" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ============ Cleanup and finish ============ -->
                        <Grid x:Name="PageSeal" Visibility="Collapsed">
                            <ScrollViewer Style="{DynamicResource PageScroll}">
                                <StackPanel Margin="40,32,40,28" MaxWidth="1000" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Cleanup and finish" Style="{DynamicResource PageTitle}"/>
                                        <TextBlock x:Name="TxtSealSubtitle" Grid.Row="1" Grid.ColumnSpan="2" Style="{DynamicResource Subtitle}" Text="The last button of an image version. The master is never sysprepped: AVDTune cleans up, puts the update block in its end state, removes every token and closes the version; the image is made by your imaging tool afterwards."/>
                                        <Button x:Name="BtnSealRun" Grid.Column="1" Style="{DynamicResource PrimaryButton}" Content="Finish" VerticalAlignment="Center" Margin="24,0,0,0" AutomationProperties.Name="Finish this image version"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Uid="seal.end.label" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="CmbSealEnd" Uid="seal.end" Width="220" SelectedIndex="0">
                                            <ComboBoxItem Uid="seal.end.none"/>
                                            <ComboBoxItem Uid="seal.end.logoff"/>
                                            <ComboBoxItem Uid="seal.end.shutdown"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="PillSeal" Style="{DynamicResource Pill}" Padding="10,2" VerticalAlignment="Center"><TextBlock x:Name="TxtSealPill" FontSize="12" FontWeight="SemiBold"/></Border>
                                                <TextBlock x:Name="TxtSealGate" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtSealNotes" Style="{DynamicResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TxtSealResult" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="BoxSealCrash" Visibility="Collapsed" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource ErrorBg}" Padding="20,14">
                                        <StackPanel>
                                            <TextBlock Text="The last finish did not end properly" FontWeight="SemiBold" Foreground="{DynamicResource Danger}"/>
                                            <TextBlock x:Name="TxtSealCrash" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <Button x:Name="BtnSealRepair" Content="Repair" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.Name="Repair the interrupted finish"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="What the finish does" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel x:Name="PanelSealSteps" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="TxtSealLater" Style="{DynamicResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ============ Pages that come in later phases ============ -->
                        <Grid x:Name="PagePlaceholder" Visibility="Collapsed">
                            <ScrollViewer Style="{DynamicResource PageScroll}">
                                <StackPanel Margin="40,32,40,28" MaxWidth="820" HorizontalAlignment="Left">
                                    <TextBlock x:Name="TxtPhTitle" Style="{DynamicResource PageTitle}"/>
                                    <Border x:Name="PillPhase" Style="{DynamicResource Pill}" Background="{DynamicResource AccentSubtle}" Margin="0,8,0,0" Padding="10,2">
                                        <TextBlock x:Name="TxtPhPhase" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Background="{DynamicResource Card}" Margin="0,20,0,0" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="What this page will do" Style="{DynamicResource CardTitle}"/>
                                            <TextBlock x:Name="TxtPhText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Text}"/>
                                            <TextBlock x:Name="TxtPhNote" Style="{DynamicResource Hint}" Margin="0,14,0,0" Text="Not built yet. Nothing on this page changes the master."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Task bar (like the busy bar of PackTune): what runs now, with the step and the progress; a click opens the list of the tasks of this session -->
            <Border x:Name="BoxTaskBar" Uid="task.bar" Grid.Row="2" Background="{DynamicResource AccentFaint}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,1,0,0" Cursor="Hand" Focusable="True">
                <StackPanel>
                    <ProgressBar x:Name="PbTask" Height="3" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Primary}" Minimum="0" Maximum="100" Visibility="Hidden"/>
                    <Grid Margin="20,4,16,5" MinHeight="22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Ellipse x:Name="DotTask" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{DynamicResource MutedText}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTaskTitle" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                            <TextBlock x:Name="TxtTaskStep" FontSize="12" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" MaxWidth="560"/>
                        </StackPanel>
                        <Border x:Name="PillTaskCount" Grid.Column="2" Style="{DynamicResource Pill}" Background="{DynamicResource AccentSubtle}" Padding="8,0" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="TxtTaskCount" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryDark}"/>
                        </Border>
                        <Border x:Name="PillTaskResult" Grid.Column="3" Style="{DynamicResource Pill}" Padding="10,0" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="TxtTaskResult" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock x:Name="TxtTaskChevron" Grid.Column="4" Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- List of the tasks of this session, opened from the bar (rows are made in code, AVDTune-TaskBar.ps1) -->
            <Border x:Name="BoxTaskList" Uid="task.list" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="70" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,16,36" Width="780" MaxHeight="460"
                    Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8">
                <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Direction="270"/></Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="18,12,10,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Uid="task.list.title" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock x:Name="TxtTaskSummary" Style="{DynamicResource Hint}" Margin="12,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="BtnTaskClose" Uid="task.close" Content="&#xE711;" Grid.Column="1" Style="{DynamicResource IconButton}"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"/>
                    <ScrollViewer Style="{DynamicResource PageScroll}" MaxHeight="400">
                        <StackPanel>
                            <TextBlock x:Name="TxtTaskEmpty" Uid="task.empty" Style="{DynamicResource Hint}" Margin="18,14,18,16"/>
                            <StackPanel x:Name="PanelTaskList"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
