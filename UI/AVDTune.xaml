<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AVDTune" Width="1280" Height="800" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <!-- Shell in the look of PackTune: UI\Theme.xaml (shared copy, light or dark through AVDTune-Theme.ps1), own title bar, navigation on the left.
         Brushes and styles are DynamicResource so the window follows a theme swap. Navigation entries and the contents of the Overview are made in code. -->
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" GlassFrameThickness="0" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/><Setter Property="Width" Value="18"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="9,6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MinWidth" Value="240"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Primary}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- Title row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource Primary}" Margin="0,0,10,0">
                        <TextBlock Text="&#xE770;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AVDTune" FontWeight="SemiBold" LineHeight="18"/>
                        <TextBlock Uid="title.subtitle" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="0,-1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border x:Name="ChipImage" Uid="title.image" Grid.Column="1" Height="34" CornerRadius="17" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="14,0" Margin="0,0,12,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtChipName" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtChipVersion" FontSize="13" Foreground="{DynamicResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button x:Name="BtnLang" Uid="title.lang" Grid.Column="2" Style="{DynamicResource IconButton}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold" MinWidth="34" Margin="0,0,4,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="BtnTheme" Uid="title.theme" Grid.Column="3" Style="{DynamicResource IconButton}" Margin="0,0,8,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top" Height="40" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Uid="title.minimize" Content="&#xE921;" Style="{DynamicResource CaptionButton}"/>
                    <Button x:Name="BtnMaximize" Uid="title.maximize" Content="&#xE922;" Style="{DynamicResource CaptionButton}"/>
                    <Button x:Name="BtnClose" Uid="title.close" Content="&#xE8BB;" Style="{DynamicResource CloseCaptionButton}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- Navigation (entries are added in code from the page table) -->
                <DockPanel Margin="8,4,8,12" LastChildFill="True">
                    <TextBlock x:Name="TxtVersion" DockPanel.Dock="Bottom" Style="{DynamicResource Hint}" Margin="12,8,0,0"/>
                    <ScrollViewer Style="{DynamicResource PageScroll}" Focusable="False"><StackPanel x:Name="NavList"/></ScrollViewer>
                </DockPanel>

                <!-- Content surface -->
                <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <!-- Read only until the snapshot gate is confirmed: shown on every page that could change the master -->
                        <Border x:Name="BoxReadOnly" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource WarningBg}" Padding="40,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtReadOnly" Uid="shell.readonly" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Warning}" FontWeight="SemiBold"/>
                                <Button x:Name="BtnReadOnlyGo" Uid="shell.readonlygo" Grid.Column="1" Margin="16,0,0,0"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                        <Border x:Name="BoxToast" Panel.ZIndex="60" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,20" Background="{DynamicResource Text}" CornerRadius="8" Padding="16,10">
                            <TextBlock x:Name="TxtToast" Foreground="{DynamicResource Surface}" TextWrapping="Wrap" MaxWidth="700"/>
                        </Border>

                        <!-- ============ Overview ============ -->
                        <Grid x:Name="PageOverview">
                            <ScrollViewer Style="{DynamicResource PageScroll}">
                                <StackPanel Margin="40,32,40,28" MaxWidth="1000" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Uid="ov.title" Style="{DynamicResource PageTitle}"/>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="TxtOverviewSubtitle" Uid="ov.subtitle" Style="{DynamicResource Subtitle}"/>
                                        <StackPanel x:Name="PanelOverviewHead" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                            <Button x:Name="BtnNewVersion" Uid="ov.newversion" Margin="0,0,8,0"/>
                                            <Button x:Name="BtnRefresh" Uid="ov.refresh" Style="{DynamicResource PrimaryButton}" Tag="&#xE72C;"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="TxtOverviewState" Style="{DynamicResource Hint}" Margin="0,12,0,0"/>
                                    <Border x:Name="BoxRelease" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Uid="rel.title" Style="{DynamicResource CardTitle}" VerticalAlignment="Center"/>
                                                <Border x:Name="PillRelease" Style="{DynamicResource Pill}" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="TxtRelStatus" FontSize="12" FontWeight="SemiBold"/></Border>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtRelDetail" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                            <TextBox x:Name="TxtRelFiles" Uid="rel.files" Visibility="Collapsed" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" MaxHeight="150" Margin="0,8,0,0" Padding="8,6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                            <TextBlock x:Name="TxtRelNotes" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                            <StackPanel x:Name="PanelRelSkip" Visibility="Collapsed" Margin="0,10,0,0">
                                                <TextBlock x:Name="TxtRelSkipHint" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox x:Name="TxtRelSkipName" Uid="rel.skipname" Width="260" Margin="0,0,8,0" Padding="8,6"/>
                                                    <Button x:Name="BtnRelSkip" Uid="rel.skip"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button x:Name="BtnRelRepair" Uid="rel.repair" Style="{DynamicResource PrimaryButton}" Visibility="Collapsed" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnRelInstall" Uid="rel.install" Style="{DynamicResource PrimaryButton}" Visibility="Collapsed" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnRelBack" Uid="rel.back" Visibility="Collapsed" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnRelCheck" Uid="rel.check" Margin="0,0,16,0"/>
                                                <CheckBox x:Name="ChkRelEarly" Uid="rel.early" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtRelLimit" Uid="rel.limit" Style="{DynamicResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                            <StackPanel x:Name="PanelRelShortcut" Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button x:Name="BtnRelShortcut" Uid="rel.shortcut" Margin="0,0,12,0"/>
                                                <TextBlock x:Name="TxtRelShortcut" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="640"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="BoxStart" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Uid="start.title" Style="{DynamicResource CardTitle}"/>
                                            <TextBlock x:Name="TxtStartHint" Uid="start.hint" Style="{DynamicResource Hint}" Margin="0,4,0,0"/>
                                            <StackPanel x:Name="PanelStages" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="BoxStage" Visibility="Collapsed" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtStageTitle" Style="{DynamicResource CardTitle}"/>
                                            <TextBlock x:Name="TxtStageIntro" Style="{DynamicResource Hint}" Margin="0,4,0,0"/>
                                            <StackPanel x:Name="PanelStageBody" Margin="0,12,0,0"/>
                                            <TextBlock x:Name="TxtStageMessage" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Button x:Name="BtnStageAction" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnStageAction2" Margin="0,0,8,0" Visibility="Collapsed"/>
                                                <Button x:Name="BtnStageClose" Uid="common.close"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="BoxRollback" Visibility="Collapsed" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Uid="ov.rollback" Style="{DynamicResource CardTitle}"/>
                                            <TextBlock x:Name="TxtRollback" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Uid="ov.image" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel x:Name="PanelIdentity" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Uid="ov.health" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel x:Name="PanelHealth" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="BoxReady" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Uid="ready.title" Style="{DynamicResource CardTitle}" VerticalAlignment="Center"/>
                                                    <Border x:Name="PillReady" Style="{DynamicResource Pill}" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="TxtReadyPill" FontSize="12" FontWeight="SemiBold"/></Border>
                                                </StackPanel>
                                                <Button x:Name="BtnReadyRun" Uid="ready.run" Grid.Column="1" Style="{DynamicResource PrimaryButton}"/>
                                            </Grid>
                                            <TextBlock x:Name="TxtReadyIntro" Uid="ready.intro" Style="{DynamicResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TxtReadySummary" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TxtReadyGate" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <StackPanel x:Name="PanelReadyRows" Margin="0,8,0,0"/>
                                            <TextBlock x:Name="TxtReadyFamilies" Style="{DynamicResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                            <StackPanel x:Name="PanelReadyAck" Visibility="Collapsed" Margin="0,14,0,0">
                                                <TextBlock x:Name="TxtReadyAckHint" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox x:Name="TxtReadyAck" Uid="ready.ackbox" Width="520" Margin="0,0,8,0" Padding="8,6"/>
                                                    <Button x:Name="BtnReadyAck" Uid="ready.ack"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <TextBlock Uid="ready.imagedef" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <ComboBox x:Name="CmbReadyGallery" Uid="ready.gallery" Width="520" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnReadyGallery" Uid="ready.use" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnReadyGalleryClear" Uid="ready.clear" Visibility="Collapsed"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtReadyGalleryState" Style="{DynamicResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ============ Protocol and change log ============ -->
                        <Grid x:Name="PageProtocol" Visibility="Collapsed" Margin="32,24,32,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Uid="prot.title" Style="{DynamicResource PageTitle}"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="TxtProtocolSubtitle" Style="{DynamicResource Subtitle}"/>
                                <StackPanel x:Name="PanelProtocolHead" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <ComboBox x:Name="CmbVersion" Uid="prot.version" Width="140" Margin="0,0,8,0" Visibility="Collapsed"/>
                                    <Button x:Name="BtnProtocolSave" Uid="prot.save" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnProtocolCopy" Uid="prot.copy" Style="{DynamicResource PrimaryButton}" Tag="&#xE8C8;"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{DynamicResource Segmented}" Background="{DynamicResource Card}" Uid="prot.view">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SegSession" Uid="prot.session" GroupName="ProtocolView" Style="{DynamicResource SegmentItem}" IsChecked="True"/>
                                        <RadioButton x:Name="SegChange" Uid="prot.change" GroupName="ProtocolView" Style="{DynamicResource SegmentItem}"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="PanelNote" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                                    <ComboBox x:Name="CmbNoteCategory" Uid="prot.category" Width="150" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CmbNoteType" Uid="prot.type" Width="100" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtNote" Uid="prot.note" Width="320" Margin="0,0,8,0" Padding="8,6" MaxLength="500"/>
                                    <Button x:Name="BtnAddNote" Uid="prot.addnote"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Style="{DynamicResource CardBox}" Background="{DynamicResource Card}" Margin="0,14,0,0" VerticalAlignment="Stretch">
                                <TextBox x:Name="TxtProtocol" Uid="prot.text" Style="{DynamicResource SelectableText}" VerticalAlignment="Stretch" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Text}" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="16,14"/>
                            </Border>
                            <TextBlock x:Name="TxtProtocolState" Grid.Row="3" Style="{DynamicResource Hint}" Margin="0,10,0,18"/>
                        </Grid>

                        <!-- ============ Updates ============ -->
                        <Grid x:Name="PageUpdates" Visibility="Collapsed">
                            <ScrollViewer Style="{DynamicResource PageScroll}">
                                <StackPanel Margin="40,32,40,28" MaxWidth="1000" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Uid="nav.updates" Style="{DynamicResource PageTitle}"/>
                                        <TextBlock Uid="upd.x.subtitle" x:Name="TxtUpdSubtitle" Grid.Row="1" Grid.ColumnSpan="2" Style="{DynamicResource Subtitle}"/>
                                        <StackPanel x:Name="PanelUpdHead" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                            <Button Uid="upd.x.scan" x:Name="BtnUpdScan" Margin="0,0,8,0"/>
                                            <Button Uid="upd.x.selected" x:Name="BtnUpdSelected" Margin="0,0,8,0"/>
                                            <Button Uid="upd.x.all" x:Name="BtnUpdAll" Style="{DynamicResource PrimaryButton}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="TxtUpdState" Style="{DynamicResource Hint}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                    <Border x:Name="BoxUpdRepair" Visibility="Collapsed" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource WarningBg}" Padding="20,14">
                                        <StackPanel>
                                            <TextBlock Uid="upd.x.anupdatefailed" FontWeight="SemiBold" Foreground="{DynamicResource Warning}"/>
                                            <TextBlock Uid="upd.x.dismrestorehealthrepairs" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Uid="upd.x.repairdism" x:Name="BtnRepairDism" Margin="0,0,8,0"/>
                                                <Button Uid="upd.x.repairsfc" x:Name="BtnRepairSfc"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Uid="upd.x.available" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel x:Name="PanelUpdItems" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="TxtUpdNotes" Style="{DynamicResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Uid="upd.x.settings" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel Margin="0,8,0,0">
                                                <CheckBox Uid="upd.x.drivers" x:Name="ChkUpdDrivers" Margin="0,2,0,2"/>
                                                <CheckBox Uid="upd.x.previews" x:Name="ChkUpdPreviews" Margin="0,2,0,2"/>
                                                <CheckBox Uid="upd.x.microsoft" x:Name="ChkUpdMicrosoft" Margin="0,2,0,2"/>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Uid="upd.x.kbexcludelist" VerticalAlignment="Center"/>
                                                    <TextBox Uid="upd.x.kbs" x:Name="TxtUpdKbs" Grid.Column="1" Padding="8,6"/>
                                                </Grid>
                                                <Button Uid="upd.x.save" x:Name="BtnUpdSave" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Uid="upd.x.history" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel x:Name="PanelUpdHistory" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ============ Office ============ -->
                        <Grid x:Name="PageOffice" Visibility="Collapsed">
                            <ScrollViewer Style="{DynamicResource PageScroll}">
                                <StackPanel Margin="40,32,40,28" MaxWidth="1000" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Uid="nav.office" Style="{DynamicResource PageTitle}"/>
                                            <TextBlock Uid="off.x.installorreconfigure" Style="{DynamicResource Subtitle}"/>
                                        </StackPanel>
                                        <Button Uid="off.x.test" x:Name="BtnOffTest" Grid.Column="1" Style="{DynamicResource PrimaryButton}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtOffState" Style="{DynamicResource Hint}" Margin="0,12,0,0" TextWrapping="Wrap"/>

                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Uid="off.x.stateofthis" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel x:Name="PanelOffRows" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Uid="off.x.configuration" Style="{DynamicResource CardTitle}"/>
                                            <TextBlock Uid="off.x.sharedcomputeractivation" Style="{DynamicResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Uid="off.x.channel" VerticalAlignment="Center" Margin="0,4"/>
                                                <ComboBox Uid="off.x.channel2" x:Name="CmbOffChannel" Grid.Column="1" Margin="0,4"/>
                                                <TextBlock Uid="off.x.32or64" Grid.Row="1" VerticalAlignment="Center" Margin="0,4"/>
                                                <ComboBox Uid="off.x.edition" x:Name="CmbOffEdition" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                                                <TextBlock Uid="off.x.licence" Grid.Row="2" VerticalAlignment="Center" Margin="0,4"/>
                                                <ComboBox Uid="off.x.license" x:Name="CmbOffLicense" Grid.Row="2" Grid.Column="1" Margin="0,4" DisplayMemberPath="Name" SelectedValuePath="Key"/>
