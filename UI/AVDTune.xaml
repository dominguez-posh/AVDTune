                                            <Button x:Name="BtnWmInstall" Style="{DynamicResource PrimaryButton}" Content="Install on this master" AutomationProperties.Name="Install the watermark on this master"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="Watermark" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border x:Name="PillWm" Style="{DynamicResource Pill}" Padding="10,2" VerticalAlignment="Center"><TextBlock x:Name="TxtWmPill" FontSize="12" FontWeight="SemiBold"/></Border>
                                                <TextBlock x:Name="TxtWmSummary" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtWmHost" Style="{DynamicResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
