                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="Update notifications for users" Style="{DynamicResource CardTitle}"/>
                                            <TextBlock Style="{DynamicResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" Text="Hides the Office update notifications and the update button for all users (two machine policies of the AVD article). Press Test to see the state; Apply asks first."/>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button x:Name="BtnOffPolicies" Content="Set update policies" Margin="0,0,8,0" AutomationProperties.Name="Hide Office update notifications for users"/>
                                                <Button x:Name="BtnOffPoliciesUndo" Content="Undo policies" Margin="0,0,8,0" AutomationProperties.Name="Put the Office policy values back"/>
                                                <Button x:Name="BtnOffFixUndo" Content="Undo one-click fixes" AutomationProperties.Name="Put back the values that the Fix buttons of the state list changed"/>
