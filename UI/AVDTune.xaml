                                            <TextBlock Text="configuration.xml (preview, this is what the ODT gets)" Style="{DynamicResource Hint}" Margin="0,12,0,4"/>
                                            <TextBox x:Name="TxtOffPreview" IsReadOnly="True" FontFamily="Consolas" Padding="8" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" MinHeight="120" AutomationProperties.Name="Preview of configuration.xml"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button x:Name="BtnOffSave" Content="Save settings" Margin="0,0,8,0" AutomationProperties.Name="Save the configuration"/>
                                                <Button x:Name="BtnOffInstall" Style="{DynamicResource PrimaryButton}" Content="Install or reconfigure" Margin="0,0,8,0" AutomationProperties.Name="Install or reconfigure Microsoft 365 Apps"/>
                                                <Button x:Name="BtnOffUndo" Content="Back to saved configuration" Margin="0,0,8,0" AutomationProperties.Name="Go back to the saved earlier Office configuration (build, languages and RemoveMSI are not restored)"/>
