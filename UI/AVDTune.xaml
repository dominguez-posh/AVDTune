                                                <ComboBox x:Name="CmbOffLicense" Grid.Row="2" Grid.Column="1" Margin="0,4" DisplayMemberPath="Name" SelectedValuePath="Key" AutomationProperties.Name="Licence of the users (decides the Microsoft 365 Apps product)"/>
                                                <TextBlock x:Name="TxtOffLicenseHint" Grid.Row="3" Grid.Column="1" Style="{DynamicResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <TextBlock Grid.Row="4" Text="Outlook" VerticalAlignment="Center" Margin="0,4"/>
                                                <ComboBox x:Name="CmbOffOutlook" Grid.Row="4" Grid.Column="1" Margin="0,4" DisplayMemberPath="Name" SelectedValuePath="Key" AutomationProperties.Name="Outlook (classic), Outlook (new) or both"/>
                                                <TextBlock x:Name="TxtOffOutlookHint" Grid.Row="5" Grid.Column="1" Style="{DynamicResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <TextBlock Grid.Row="6" Text="Languages" VerticalAlignment="Top" Margin="0,8"/>
