<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AVDTune" Width="1280" Height="800" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <!-- Shell in the look of PackTune: UI\Theme.xaml (shared copy, light or dark through AVDTune-Theme.ps1), own title bar, navigation on the left.
         Brushes and styles are DynamicResource so the window follows a theme swap. Navigation entries and the contents of the Overview are made in code. -->
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" GlassFrameThickness="0" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/><Setter Property="Width" Value="18"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="9,6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MinWidth" Value="240"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Primary}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- Title row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource Primary}" Margin="0,0,10,0">
                        <TextBlock Text="&#xE770;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AVDTune" FontWeight="SemiBold" LineHeight="18"/>
                        <TextBlock Text="Golden Master for Azure Virtual Desktop" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="0,-1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border x:Name="ChipImage" Grid.Column="1" Height="34" CornerRadius="17" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="14,0" Margin="0,0,12,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Image">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtChipName" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtChipVersion" FontSize="13" Foreground="{DynamicResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button x:Name="BtnTheme" Grid.Column="2" Style="{DynamicResource IconButton}" Content="&#xE706;" Margin="0,0,8,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Switch between light and dark" ToolTip="Light or dark"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Height="40" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Style="{DynamicResource CaptionButton}" Content="&#xE921;" AutomationProperties.Name="Minimize" ToolTip="Minimize"/>
                    <Button x:Name="BtnMaximize" Style="{DynamicResource CaptionButton}" Content="&#xE922;" AutomationProperties.Name="Maximize" ToolTip="Maximize"/>
                    <Button x:Name="BtnClose" Style="{DynamicResource CloseCaptionButton}" Content="&#xE8BB;" AutomationProperties.Name="Close" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- Navigation (entries are added in code from the page table) -->
                <DockPanel Margin="8,4,8,12" LastChildFill="True">
                    <TextBlock x:Name="TxtVersion" DockPanel.Dock="Bottom" Style="{DynamicResource Hint}" Margin="12,8,0,0"/>
                    <ScrollViewer Style="{DynamicResource PageScroll}" Focusable="False"><StackPanel x:Name="NavList"/></ScrollViewer>
                </DockPanel>

                <!-- Content surface -->
                <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <!-- Read only until the snapshot gate is confirmed: shown on every page that could change the master -->
                        <Border x:Name="BoxReadOnly" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource WarningBg}" Padding="40,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtReadOnly" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Warning}" FontWeight="SemiBold" Text="Read only: confirm a snapshot of today on the Overview first. Nothing on this page changes the master until then."/>
                                <Button x:Name="BtnReadOnlyGo" Grid.Column="1" Content="Go to the Overview" Margin="16,0,0,0" AutomationProperties.Name="Go to the Overview to finish the start sequence"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                        <Border x:Name="BoxToast" Panel.ZIndex="60" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,20" Background="{DynamicResource Text}" CornerRadius="8" Padding="16,10">
                            <TextBlock x:Name="TxtToast" Foreground="{DynamicResource Surface}" TextWrapping="Wrap" MaxWidth="700"/>
                        </Border>

                        <!-- ============ Overview ============ -->
                        <Grid x:Name="PageOverview">
                            <ScrollViewer Style="{DynamicResource PageScroll}">
                                <StackPanel Margin="40,32,40,28" MaxWidth="1000" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Overview" Style="{DynamicResource PageTitle}"/>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="TxtOverviewSubtitle" Style="{DynamicResource Subtitle}" Text="This Golden Master at a glance: image, builds and what stands in the way of finishing the version."/>
                                        <StackPanel x:Name="PanelOverviewHead" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                            <Button x:Name="BtnNewVersion" Content="Start new version" Margin="0,0,8,0" AutomationProperties.Name="Start new image version"/>
                                            <Button x:Name="BtnRefresh" Style="{DynamicResource PrimaryButton}" Content="Refresh" Tag="&#xE72C;" AutomationProperties.Name="Refresh the overview"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="TxtOverviewState" Style="{DynamicResource Hint}" Margin="0,12,0,0"/>
                                    <Border x:Name="BoxRelease" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Integrity and updates" Style="{DynamicResource CardTitle}" VerticalAlignment="Center"/>
                                                <Border x:Name="PillRelease" Style="{DynamicResource Pill}" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="TxtRelStatus" FontSize="12" FontWeight="SemiBold"/></Border>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtRelDetail" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                            <TextBox x:Name="TxtRelFiles" Visibility="Collapsed" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" MaxHeight="150" Margin="0,8,0,0" Padding="8,6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Files that differ from the release"/>
                                            <TextBlock x:Name="TxtRelNotes" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                            <StackPanel x:Name="PanelRelSkip" Visibility="Collapsed" Margin="0,10,0,0">
                                                <TextBlock x:Name="TxtRelSkipHint" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox x:Name="TxtRelSkipName" Width="260" Margin="0,0,8,0" Padding="8,6" AutomationProperties.Name="Computer name to continue without the check"/>
                                                    <Button x:Name="BtnRelSkip" Content="Continue without check" AutomationProperties.Name="Continue without the integrity check"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button x:Name="BtnRelRepair" Style="{DynamicResource PrimaryButton}" Content="Repair" Visibility="Collapsed" Margin="0,0,8,0" AutomationProperties.Name="Repair the files of AVDTune from the release"/>
                                                <Button x:Name="BtnRelInstall" Style="{DynamicResource PrimaryButton}" Content="Install update" Visibility="Collapsed" Margin="0,0,8,0" AutomationProperties.Name="Install the newer version side by side"/>
                                                <Button x:Name="BtnRelBack" Content="Back to the previous version" Visibility="Collapsed" Margin="0,0,8,0" AutomationProperties.Name="Switch back to the previous version"/>
                                                <Button x:Name="BtnRelCheck" Content="Check for updates" Margin="0,0,16,0" AutomationProperties.Name="Check GitHub for a newer version"/>
                                                <CheckBox x:Name="ChkRelEarly" Content="Include early access releases" VerticalAlignment="Center" AutomationProperties.Name="Include early access releases in the update check"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtRelLimit" Style="{DynamicResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap" Text="Limit: the check proves that the files are the ones published on GitHub for this version and unchanged on this master. It does not protect against a compromised GitHub account or repository. Updates are installed only when you click, never during a run or the maintenance mode."/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="BoxStart" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="Start sequence" Style="{DynamicResource CardTitle}"/>
                                            <TextBlock x:Name="TxtStartHint" Style="{DynamicResource Hint}" Margin="0,4,0,0" Text="Nothing changes the master before these steps are done. Every page stays read only until the snapshot is confirmed."/>
                                            <StackPanel x:Name="PanelStages" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="BoxStage" Visibility="Collapsed" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtStageTitle" Style="{DynamicResource CardTitle}"/>
                                            <TextBlock x:Name="TxtStageIntro" Style="{DynamicResource Hint}" Margin="0,4,0,0"/>
                                            <StackPanel x:Name="PanelStageBody" Margin="0,12,0,0"/>
                                            <TextBlock x:Name="TxtStageMessage" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Button x:Name="BtnStageAction" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnStageAction2" Margin="0,0,8,0" Visibility="Collapsed"/>
                                                <Button x:Name="BtnStageClose" Content="Close"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="BoxRollback" Visibility="Collapsed" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="Rollback" Style="{DynamicResource CardTitle}"/>
                                            <TextBlock x:Name="TxtRollback" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="Image" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel x:Name="PanelIdentity" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="Health" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel x:Name="PanelHealth" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="BoxReady" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Readiness" Style="{DynamicResource CardTitle}" VerticalAlignment="Center"/>
                                                    <Border x:Name="PillReady" Style="{DynamicResource Pill}" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="TxtReadyPill" FontSize="12" FontWeight="SemiBold"/></Border>
                                                </StackPanel>
                                                <Button x:Name="BtnReadyRun" Grid.Column="1" Style="{DynamicResource PrimaryButton}" Content="Run analysis" AutomationProperties.Name="Run the readiness analysis"/>
                                            </Grid>
                                            <TextBlock x:Name="TxtReadyIntro" Style="{DynamicResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" Text="Is this master ready for the current VM sizes (v6/v7) and clean enough to become an image? Read only; every finding has its reason, its Microsoft Learn source and a fix hint."/>
                                            <TextBlock x:Name="TxtReadySummary" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TxtReadyGate" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <StackPanel x:Name="PanelReadyRows" Margin="0,8,0,0"/>
                                            <TextBlock x:Name="TxtReadyFamilies" Style="{DynamicResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                            <StackPanel x:Name="PanelReadyAck" Visibility="Collapsed" Margin="0,14,0,0">
                                                <TextBlock x:Name="TxtReadyAckHint" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox x:Name="TxtReadyAck" Width="520" Margin="0,0,8,0" Padding="8,6" AutomationProperties.Name="Names of the open items to confirm"/>
                                                    <Button x:Name="BtnReadyAck" Content="Confirm" AutomationProperties.Name="Confirm the open items by name"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <TextBlock Text="Image definition" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <ComboBox x:Name="CmbReadyGallery" Width="520" Margin="0,0,8,0" AutomationProperties.Name="Image definition in the Azure Compute Gallery"/>
                                                <Button x:Name="BtnReadyGallery" Content="Use" Margin="0,0,8,0" AutomationProperties.Name="Use the chosen image definition"/>
                                                <Button x:Name="BtnReadyGalleryClear" Content="Clear" Visibility="Collapsed" AutomationProperties.Name="Clear the chosen image definition"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtReadyGalleryState" Style="{DynamicResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ============ Protocol and change log ============ -->
                        <Grid x:Name="PageProtocol" Visibility="Collapsed" Margin="32,24,32,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Protocol and change log" Style="{DynamicResource PageTitle}"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="TxtProtocolSubtitle" Style="{DynamicResource Subtitle}"/>
                                <StackPanel x:Name="PanelProtocolHead" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <ComboBox x:Name="CmbProtocolLanguage" Width="120" Margin="0,0,8,0" AutomationProperties.Name="Language of the protocol"/>
                                    <ComboBox x:Name="CmbVersion" Width="140" Margin="0,0,8,0" Visibility="Collapsed" AutomationProperties.Name="Image version"/>
                                    <Button x:Name="BtnProtocolSave" Content="Save as file" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnProtocolCopy" Style="{DynamicResource PrimaryButton}" Content="Copy" Tag="&#xE8C8;"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{DynamicResource Segmented}" Background="{DynamicResource Card}" AutomationProperties.Name="View">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SegSession" GroupName="ProtocolView" Style="{DynamicResource SegmentItem}" Content="Session protocol" IsChecked="True"/>
                                        <RadioButton x:Name="SegChange" GroupName="ProtocolView" Style="{DynamicResource SegmentItem}" Content="Change log"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="PanelNote" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                                    <ComboBox x:Name="CmbNoteCategory" Width="150" Margin="0,0,8,0" AutomationProperties.Name="Category of the note"/>
                                    <ComboBox x:Name="CmbNoteType" Width="100" Margin="0,0,8,0" AutomationProperties.Name="Change type"/>
                                    <TextBox x:Name="TxtNote" Width="320" Margin="0,0,8,0" Padding="8,6" MaxLength="500" AutomationProperties.Name="Note for the change log"/>
                                    <Button x:Name="BtnAddNote" Content="Add note"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Style="{DynamicResource CardBox}" Background="{DynamicResource Card}" Margin="0,14,0,0" VerticalAlignment="Stretch">
                                <TextBox x:Name="TxtProtocol" Style="{DynamicResource SelectableText}" VerticalAlignment="Stretch" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Text}" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="16,14" AutomationProperties.Name="Protocol text"/>
                            </Border>
                            <TextBlock x:Name="TxtProtocolState" Grid.Row="3" Style="{DynamicResource Hint}" Margin="0,10,0,18"/>
                        </Grid>

                        <!-- ============ Updates ============ -->
                        <Grid x:Name="PageUpdates" Visibility="Collapsed">
                            <ScrollViewer Style="{DynamicResource PageScroll}">
                                <StackPanel Margin="40,32,40,28" MaxWidth="1000" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Updates" Style="{DynamicResource PageTitle}"/>
                                        <TextBlock x:Name="TxtUpdSubtitle" Grid.Row="1" Grid.ColumnSpan="2" Style="{DynamicResource Subtitle}" Text="One list for Windows, Microsoft 365 Apps, Edge, Teams, OneDrive, FSLogix, Defender and your apps. A run lifts the update block for itself and puts it back."/>
                                        <StackPanel x:Name="PanelUpdHead" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                            <Button x:Name="BtnUpdScan" Content="Search" Margin="0,0,8,0" AutomationProperties.Name="Search for updates"/>
                                            <Button x:Name="BtnUpdSelected" Content="Update selected" Margin="0,0,8,0" AutomationProperties.Name="Update the selected items"/>
                                            <Button x:Name="BtnUpdAll" Style="{DynamicResource PrimaryButton}" Content="Update all" AutomationProperties.Name="Update all items"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="TxtUpdState" Style="{DynamicResource Hint}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                    <Border x:Name="BoxUpdRepair" Visibility="Collapsed" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource WarningBg}" Padding="20,14">
                                        <StackPanel>
                                            <TextBlock Text="An update failed in a way that a repair can fix" FontWeight="SemiBold" Foreground="{DynamicResource Warning}"/>
                                            <TextBlock Text="DISM /RestoreHealth repairs the component store, sfc checks the system files. Both take a while." TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button x:Name="BtnRepairDism" Content="Run DISM /RestoreHealth" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnRepairSfc" Content="Run sfc /scannow"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="Available" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel x:Name="PanelUpdItems" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="TxtUpdNotes" Style="{DynamicResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="Settings" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel Margin="0,8,0,0">
                                                <CheckBox x:Name="ChkUpdDrivers" Content="Include drivers (off by default)" Margin="0,2,0,2"/>
                                                <CheckBox x:Name="ChkUpdPreviews" Content="Include preview updates (off by default)" Margin="0,2,0,2"/>
                                                <CheckBox x:Name="ChkUpdMicrosoft" Content="Updates for other Microsoft products (.NET and more, registers Microsoft Update)" Margin="0,2,0,2"/>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="KB exclude list" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="TxtUpdKbs" Grid.Column="1" Padding="8,6" AutomationProperties.Name="KB numbers to exclude, separated by commas"/>
                                                </Grid>
                                                <Button x:Name="BtnUpdSave" Content="Save settings" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="History" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel x:Name="PanelUpdHistory" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ============ Update block ============ -->
                        <Grid x:Name="PageUpdateBlock" Visibility="Collapsed">
                            <ScrollViewer Style="{DynamicResource PageScroll}">
                                <StackPanel Margin="40,32,40,28" MaxWidth="1000" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Update block" Style="{DynamicResource PageTitle}"/>
                                        <TextBlock x:Name="TxtBlockSubtitle" Grid.Row="1" Grid.ColumnSpan="2" Style="{DynamicResource Subtitle}" Text="Everything that offers or runs updates is hidden and off for users. Maintenance mode lifts it for the own AVDTune run only."/>
                                        <StackPanel x:Name="PanelBlockHead" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                            <Button x:Name="BtnBlockOff" Content="Switch off" Margin="0,0,8,0" AutomationProperties.Name="Switch the update block off"/>
                                            <Button x:Name="BtnBlockOn" Style="{DynamicResource PrimaryButton}" Content="Switch on" AutomationProperties.Name="Switch the update block on"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="PillBlock" Style="{DynamicResource Pill}" Padding="10,2" VerticalAlignment="Center"><TextBlock x:Name="TxtBlockPill" FontSize="12" FontWeight="SemiBold"/></Border>
                                                <TextBlock x:Name="TxtBlockSummary" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtBlockFindings" Style="{DynamicResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="BoxBlockCrash" Visibility="Collapsed" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource ErrorBg}" Padding="20,14">
                                        <StackPanel>
                                            <TextBlock Text="Maintenance mode did not end properly" FontWeight="SemiBold" Foreground="{DynamicResource Danger}"/>
                                            <TextBlock x:Name="TxtBlockCrash" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <Button x:Name="BtnBlockRepair" Content="Repair the update block" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="Settings of the block" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel x:Name="PanelBlockItems" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ============ User experience ============ -->
                        <Grid x:Name="PageUserExperience" Visibility="Collapsed">
                            <ScrollViewer Style="{DynamicResource PageScroll}">
                                <StackPanel Margin="40,32,40,28" MaxWidth="1000" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="User experience" Style="{DynamicResource PageTitle}"/>
                                        <TextBlock x:Name="TxtUxSubtitle" Grid.Row="1" Grid.ColumnSpan="2" Style="{DynamicResource Subtitle}" Text="What users see on the desktop of the image. Now: the watermark for pilot hosts. Wallpaper, Start layout and shortcuts follow."/>
                                        <StackPanel x:Name="PanelUxHead" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                            <Button x:Name="BtnWmRemove" Content="Remove from this master" Margin="0,0,8,0" AutomationProperties.Name="Remove the watermark from this master"/>
                                            <Button x:Name="BtnWmInstall" Style="{DynamicResource PrimaryButton}" Content="Install on this master" AutomationProperties.Name="Install the watermark on this master"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="Watermark" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border x:Name="PillWm" Style="{DynamicResource Pill}" Padding="10,2" VerticalAlignment="Center"><TextBlock x:Name="TxtWmPill" FontSize="12" FontWeight="SemiBold"/></Border>
                                                <TextBlock x:Name="TxtWmSummary" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtWmHost" Style="{DynamicResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="BoxWmLegacy" Visibility="Collapsed" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource WarningBg}" Padding="20,14">
                                        <StackPanel>
                                            <TextBlock Text="The old overlay is still on this master" FontWeight="SemiBold" Foreground="{DynamicResource Warning}"/>
                                            <TextBlock x:Name="TxtWmLegacy" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <Button x:Name="BtnWmLegacy" Content="Remove the old overlay" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.Name="Remove the old overlay"/>
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Style="{DynamicResource CardBox}" Background="{DynamicResource Card}" Padding="20,16">
                                            <StackPanel>
                                                <TextBlock Text="Settings" Style="{DynamicResource CardTitle}"/>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Computer name pattern" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                                    <TextBox x:Name="TxtWmPattern" Grid.Column="1" Padding="8,6" Margin="0,0,0,8" AutomationProperties.Name="Computer name pattern, a regular expression"/>
                                                    <TextBlock Text="Try a name" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                                    <TextBox x:Name="TxtWmTryName" Grid.Row="1" Grid.Column="1" Padding="8,6" Margin="0,0,0,2" AutomationProperties.Name="Computer name to try the pattern on"/>
                                                    <TextBlock x:Name="TxtWmMatch" Grid.Row="2" Grid.ColumnSpan="2" Style="{DynamicResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                    <TextBlock Text="Text" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                    <TextBox x:Name="TxtWmText" Grid.Row="3" Grid.Column="1" Padding="8,6" Margin="0,0,0,8" AutomationProperties.Name="Watermark text"/>
                                                    <TextBlock Text="Colour" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                                        <TextBox x:Name="TxtWmColor" Width="110" Padding="8,6" AutomationProperties.Name="Colour as #RRGGBB"/>
                                                        <Border x:Name="BoxWmSwatch" Width="28" Height="28" CornerRadius="4" Margin="10,0,0,0" BorderThickness="1" BorderBrush="{DynamicResource Border}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Opacity (10-100 %)" Grid.Row="5" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                    <TextBox x:Name="TxtWmOpacity" Grid.Row="5" Grid.Column="1" Width="110" HorizontalAlignment="Left" Padding="8,6" Margin="0,0,0,8" AutomationProperties.Name="Opacity in percent"/>
                                                    <TextBlock Text="Font size (8-96)" Grid.Row="6" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                    <TextBox x:Name="TxtWmSize" Grid.Row="6" Grid.Column="1" Width="110" HorizontalAlignment="Left" Padding="8,6" Margin="0,0,0,8" AutomationProperties.Name="Font size"/>
                                                    <TextBlock Text="Corner" Grid.Row="7" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                    <ComboBox x:Name="CmbWmCorner" Grid.Row="7" Grid.Column="1" Width="170" HorizontalAlignment="Left" Margin="0,0,0,8" AutomationProperties.Name="Corner of every monitor"/>
                                                    <TextBlock Text="Distance (0-500 px)" Grid.Row="8" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                    <TextBox x:Name="TxtWmMargin" Grid.Row="8" Grid.Column="1" Width="110" HorizontalAlignment="Left" Padding="8,6" Margin="0,0,0,8" AutomationProperties.Name="Distance from the edge in pixels"/>
                                                </Grid>
                                                <CheckBox x:Name="ChkWmHeadless" Content="Start without any console window flash (conhost --headless)" Margin="0,6,0,2"/>
                                                <TextBlock Text="powershell.exe -WindowStyle Hidden opens its console window before it hides it, so one can flash for a moment at logon. conhost --headless avoids that on current Windows 10 and 11, but Microsoft does not document it and some security tools flag it. Off by default." Style="{DynamicResource Hint}" TextWrapping="Wrap" Margin="24,0,0,8"/>
                                                <CheckBox x:Name="ChkWmMs" Content="Also switch on the Microsoft QR code watermark (connection ID in every remote session)" Margin="0,6,0,2"/>
                                                <TextBlock Text="For forensics: a photo of the screen can be traced to a session. Once it is on, only clients that support watermarking can connect (the others fail with an unspecific error); RemoteApp is not marked." Style="{DynamicResource Hint}" TextWrapping="Wrap" Margin="24,0,0,8"/>
                                                <TextBlock x:Name="TxtWmErrors" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <Button x:Name="BtnWmSave" Content="Save settings" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{DynamicResource CardBox}" Background="{DynamicResource Card}" Padding="16" VerticalAlignment="Top">
                                            <StackPanel>
                                                <TextBlock Text="Preview" Style="{DynamicResource CardTitle}"/>
                                                <Border x:Name="BoxWmDesktop" Width="480" Height="270" Margin="0,10,0,0" Background="#FF3E5C8A" ClipToBounds="True" AutomationProperties.Name="Preview of one monitor">
                                                    <Canvas x:Name="CanvasWm">
                                                        <Rectangle x:Name="RectWmTaskbar" Width="480" Height="8" Fill="#CC101820" Canvas.Top="262"/>
                                                        <TextBlock x:Name="TxtWmPreview" FontWeight="Bold" Canvas.Left="0" Canvas.Top="0" AutomationProperties.Name="Watermark preview"/>
                                                    </Canvas>
                                                </Border>
                                                <TextBlock x:Name="TxtWmPreviewNote" Style="{DynamicResource Hint}" TextWrapping="Wrap" Width="480" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="On this master" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel x:Name="PanelWmItems" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="TxtWmNotes" Style="{DynamicResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ============ Pages that come in later phases ============ -->
                        <Grid x:Name="PagePlaceholder" Visibility="Collapsed">
                            <ScrollViewer Style="{DynamicResource PageScroll}">
                                <StackPanel Margin="40,32,40,28" MaxWidth="820" HorizontalAlignment="Left">
                                    <TextBlock x:Name="TxtPhTitle" Style="{DynamicResource PageTitle}"/>
                                    <Border x:Name="PillPhase" Style="{DynamicResource Pill}" Background="{DynamicResource AccentSubtle}" Margin="0,8,0,0" Padding="10,2">
                                        <TextBlock x:Name="TxtPhPhase" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Background="{DynamicResource Card}" Margin="0,20,0,0" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="What this page will do" Style="{DynamicResource CardTitle}"/>
                                            <TextBlock x:Name="TxtPhText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Text}"/>
                                            <TextBlock x:Name="TxtPhNote" Style="{DynamicResource Hint}" Margin="0,14,0,0" Text="Not built yet. Nothing on this page changes the master."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
