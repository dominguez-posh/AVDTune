<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AVDTune" Width="1280" Height="800" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <!-- Shell in the look of PackTune: UI\Theme.xaml (shared copy, light or dark through AVDTune-Theme.ps1), own title bar, navigation on the left.
         Brushes and styles are DynamicResource so the window follows a theme swap. Navigation entries and the contents of the Overview are made in code. -->
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" GlassFrameThickness="0" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/><Setter Property="Width" Value="18"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="9,6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MinWidth" Value="240"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Primary}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- Title row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource Primary}" Margin="0,0,10,0">
                        <TextBlock Text="&#xE770;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AVDTune" FontWeight="SemiBold" LineHeight="18"/>
                        <TextBlock Text="Golden Master for Azure Virtual Desktop" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="0,-1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border x:Name="ChipImage" Grid.Column="1" Height="34" CornerRadius="17" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="14,0" Margin="0,0,12,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Image">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtChipName" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtChipVersion" FontSize="13" Foreground="{DynamicResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button x:Name="BtnTheme" Grid.Column="2" Style="{DynamicResource IconButton}" Content="&#xE706;" Margin="0,0,8,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Switch between light and dark" ToolTip="Light or dark"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Height="40" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Style="{DynamicResource CaptionButton}" Content="&#xE921;" AutomationProperties.Name="Minimize" ToolTip="Minimize"/>
                    <Button x:Name="BtnMaximize" Style="{DynamicResource CaptionButton}" Content="&#xE922;" AutomationProperties.Name="Maximize" ToolTip="Maximize"/>
                    <Button x:Name="BtnClose" Style="{DynamicResource CloseCaptionButton}" Content="&#xE8BB;" AutomationProperties.Name="Close" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- Navigation (entries are added in code from the page table) -->
                <DockPanel Margin="8,4,8,12" LastChildFill="True">
                    <TextBlock x:Name="TxtVersion" DockPanel.Dock="Bottom" Style="{DynamicResource Hint}" Margin="12,8,0,0"/>
                    <ScrollViewer Style="{DynamicResource PageScroll}" Focusable="False"><StackPanel x:Name="NavList"/></ScrollViewer>
                </DockPanel>

                <!-- Content surface -->
                <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <!-- Read only until the snapshot gate is confirmed: shown on every page that could change the master -->
                        <Border x:Name="BoxReadOnly" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource WarningBg}" Padding="40,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtReadOnly" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Warning}" FontWeight="SemiBold" Text="Read only: confirm a snapshot of today on the Overview first. Nothing on this page changes the master until then."/>
                                <Button x:Name="BtnReadOnlyGo" Grid.Column="1" Content="Go to the Overview" Margin="16,0,0,0" AutomationProperties.Name="Go to the Overview to finish the start sequence"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                        <Border x:Name="BoxToast" Panel.ZIndex="60" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,20" Background="{DynamicResource Text}" CornerRadius="8" Padding="16,10">
                            <TextBlock x:Name="TxtToast" Foreground="{DynamicResource Surface}" TextWrapping="Wrap" MaxWidth="700"/>
                        </Border>

                        <!-- ============ Overview ============ -->
                        <Grid x:Name="PageOverview">
                            <ScrollViewer Style="{DynamicResource PageScroll}">
                                <StackPanel Margin="40,32,40,28" MaxWidth="1000" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Overview" Style="{DynamicResource PageTitle}"/>
                                            <TextBlock x:Name="TxtOverviewSubtitle" Style="{DynamicResource Subtitle}" Text="This Golden Master at a glance: image, builds and what stands in the way of a seal."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <Button x:Name="BtnNewVersion" Content="Start new version" Margin="0,0,8,0" AutomationProperties.Name="Start new image version"/>
                                            <Button x:Name="BtnRefresh" Style="{DynamicResource PrimaryButton}" Content="Refresh" Tag="&#xE72C;" AutomationProperties.Name="Refresh the overview"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="TxtOverviewState" Style="{DynamicResource Hint}" Margin="0,12,0,0"/>
                                    <Border x:Name="BoxStart" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="Start sequence" Style="{DynamicResource CardTitle}"/>
                                            <TextBlock x:Name="TxtStartHint" Style="{DynamicResource Hint}" Margin="0,4,0,0" Text="Nothing changes the master before these steps are done. Every page stays read only until the snapshot is confirmed."/>
                                            <StackPanel x:Name="PanelStages" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="BoxStage" Visibility="Collapsed" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtStageTitle" Style="{DynamicResource CardTitle}"/>
                                            <TextBlock x:Name="TxtStageIntro" Style="{DynamicResource Hint}" Margin="0,4,0,0"/>
                                            <StackPanel x:Name="PanelStageBody" Margin="0,12,0,0"/>
                                            <TextBlock x:Name="TxtStageMessage" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Button x:Name="BtnStageAction" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnStageAction2" Margin="0,0,8,0" Visibility="Collapsed"/>
                                                <Button x:Name="BtnStageClose" Content="Close"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="BoxRollback" Visibility="Collapsed" Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="Rollback" Style="{DynamicResource CardTitle}"/>
                                            <TextBlock x:Name="TxtRollback" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="Image" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel x:Name="PanelIdentity" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="Health" Style="{DynamicResource CardTitle}"/>
                                            <StackPanel x:Name="PanelHealth" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ============ Protocol and change log ============ -->
                        <Grid x:Name="PageProtocol" Visibility="Collapsed" Margin="32,24,32,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Protocol and change log" Style="{DynamicResource PageTitle}"/>
                                    <TextBlock x:Name="TxtProtocolSubtitle" Style="{DynamicResource Subtitle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <ComboBox x:Name="CmbProtocolLanguage" Width="120" Margin="0,0,8,0" AutomationProperties.Name="Language of the protocol"/>
                                    <ComboBox x:Name="CmbVersion" Width="140" Margin="0,0,8,0" Visibility="Collapsed" AutomationProperties.Name="Image version"/>
                                    <Button x:Name="BtnProtocolSave" Content="Save as file" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnProtocolCopy" Style="{DynamicResource PrimaryButton}" Content="Copy" Tag="&#xE8C8;"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{DynamicResource Segmented}" Background="{DynamicResource Card}" AutomationProperties.Name="View">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SegSession" GroupName="ProtocolView" Style="{DynamicResource SegmentItem}" Content="Session protocol" IsChecked="True"/>
                                        <RadioButton x:Name="SegChange" GroupName="ProtocolView" Style="{DynamicResource SegmentItem}" Content="Change log"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="PanelNote" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                                    <ComboBox x:Name="CmbNoteCategory" Width="150" Margin="0,0,8,0" AutomationProperties.Name="Category of the note"/>
                                    <ComboBox x:Name="CmbNoteType" Width="100" Margin="0,0,8,0" AutomationProperties.Name="Change type"/>
                                    <TextBox x:Name="TxtNote" Width="320" Margin="0,0,8,0" Padding="8,6" MaxLength="500" AutomationProperties.Name="Note for the change log"/>
                                    <Button x:Name="BtnAddNote" Content="Add note"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Style="{DynamicResource CardBox}" Background="{DynamicResource Card}" Margin="0,14,0,0" VerticalAlignment="Stretch">
                                <TextBox x:Name="TxtProtocol" Style="{DynamicResource SelectableText}" VerticalAlignment="Stretch" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Text}" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="16,14" AutomationProperties.Name="Protocol text"/>
                            </Border>
                            <TextBlock x:Name="TxtProtocolState" Grid.Row="3" Style="{DynamicResource Hint}" Margin="0,10,0,18"/>
                        </Grid>

                        <!-- ============ Pages that come in later phases ============ -->
                        <Grid x:Name="PagePlaceholder" Visibility="Collapsed">
                            <ScrollViewer Style="{DynamicResource PageScroll}">
                                <StackPanel Margin="40,32,40,28" MaxWidth="820" HorizontalAlignment="Left">
                                    <TextBlock x:Name="TxtPhTitle" Style="{DynamicResource PageTitle}"/>
                                    <Border x:Name="PillPhase" Style="{DynamicResource Pill}" Background="{DynamicResource AccentSubtle}" Margin="0,8,0,0" Padding="10,2">
                                        <TextBlock x:Name="TxtPhPhase" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/>
                                    </Border>
                                    <Border Style="{DynamicResource CardBox}" Background="{DynamicResource Card}" Margin="0,20,0,0" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="What this page will do" Style="{DynamicResource CardTitle}"/>
                                            <TextBlock x:Name="TxtPhText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Text}"/>
                                            <TextBlock x:Name="TxtPhNote" Style="{DynamicResource Hint}" Margin="0,14,0,0" Text="Not built yet. Nothing on this page changes the master."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
