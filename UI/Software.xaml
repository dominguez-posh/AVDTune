<!-- The Software page (issue 31). Loaded by AVDTune-Software.ps1 and added next to the other pages, so UI\AVDTune.xaml stays untouched.
     Brushes and styles are DynamicResource (the theme of the window); the rows of the lists are made in code. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageSoftware" Visibility="Collapsed">
    <ScrollViewer Style="{DynamicResource PageScroll}">
        <StackPanel Margin="40,32,40,28" MaxWidth="1000" HorizontalAlignment="Left">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Uid="nav.software" Style="{DynamicResource PageTitle}"/>
                <TextBlock Uid="sw.x.subtitle" x:Name="TxtSwSubtitle" Grid.Row="1" Grid.ColumnSpan="2" Style="{DynamicResource Subtitle}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <Button Uid="sw.x.refresh" x:Name="BtnSwRefresh" Margin="0,0,8,0"/>
                    <Button Uid="sw.x.updateall" x:Name="BtnSwUpdateAll" Style="{DynamicResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="TxtSwState" Style="{DynamicResource Hint}" Margin="0,12,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtSwNotes" Style="{DynamicResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Uid="sw.x.packagesthatwinget" Style="{DynamicResource CardTitle}"/>
                    <TextBlock Uid="sw.x.updateandremove" Style="{DynamicResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <StackPanel x:Name="PanelSwManaged" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Uid="sw.x.findsoftware" Style="{DynamicResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox Uid="sw.x.query" x:Name="TxtSwQuery" Width="320" Margin="0,0,8,0" MaxLength="64"/>
                        <ComboBox Uid="sw.x.source" x:Name="CmbSwSource" Width="150" Margin="0,0,8,0"/>
                        <Button Uid="sw.x.search" x:Name="BtnSwSearch" Style="{DynamicResource PrimaryButton}"/>
                    </StackPanel>
                    <TextBlock Uid="sw.x.lettersdigitsspace" Style="{DynamicResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <StackPanel x:Name="PanelSwResults" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Uid="sw.x.packtunelibrary" Style="{DynamicResource CardTitle}"/>
                    <TextBlock Uid="sw.x.thepackagestore" Style="{DynamicResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Uid="sw.x.site" VerticalAlignment="Center" Margin="0,0,8,0" Width="60"/>
                        <TextBox Uid="sw.x.site2" x:Name="TxtSwSite" Width="420" Margin="0,0,8,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Uid="sw.x.library" VerticalAlignment="Center" Margin="0,0,8,0" Width="60"/>
                        <TextBox Uid="sw.x.library2" x:Name="TxtSwLibrary" Width="260" Margin="0,0,8,0"/>
                        <Button Uid="sw.x.savesite" x:Name="BtnSwSaveSite"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSwLibState" Style="{DynamicResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <StackPanel x:Name="PanelSwLibrary" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Uid="sw.x.installedtitle" x:Name="TxtSwInstalledTitle" Style="{DynamicResource CardTitle}"/>
                    <StackPanel x:Name="PanelSwInstalled" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Uid="upd.x.history" Style="{DynamicResource CardTitle}"/>
                    <StackPanel x:Name="PanelSwHistory" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Grid>
