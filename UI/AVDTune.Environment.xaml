<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageEnvironment" Visibility="Collapsed">
    <!-- The environment page (docs\environment-wizard.md): loaded by AVDTune-Environment.ps1 and added next to the other pages of the window; styles and brushes come from the window resources
         (DynamicResource, so the page follows a theme swap). The form fields and the plan rows are made in code. -->
    <ScrollViewer Style="{DynamicResource PageScroll}">
        <StackPanel Margin="40,32,40,28" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Uid="nav.environment" Style="{DynamicResource PageTitle}"/>
            <TextBlock Uid="env.x.subtitle" x:Name="TxtEnvSubtitle" Style="{DynamicResource Subtitle}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtEnvState" Style="{DynamicResource Hint}" Margin="0,12,0,0" TextWrapping="Wrap"/>

            <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Uid="env.x.whatyouwant" Style="{DynamicResource CardTitle}"/>
                    <TextBlock x:Name="TxtEnvModel" Style="{DynamicResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <StackPanel x:Name="PanelEnvFields" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Uid="env.x.plan" x:Name="BtnEnvPlan" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Uid="env.x.apply" x:Name="BtnEnvApply" Margin="0,0,8,0" IsEnabled="False"/>
                        <Button Uid="env.x.undoplan" x:Name="BtnEnvUndoPlan" Margin="0,0,8,0"/>
                        <Button Uid="env.x.undo" x:Name="BtnEnvUndo" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtEnvResult" Style="{DynamicResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Uid="env.x.plantitle" x:Name="TxtEnvPlanTitle" Style="{DynamicResource CardTitle}"/>
                    <StackPanel x:Name="PanelEnvPlan" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBox}" Margin="0,16,0,0" Background="{DynamicResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Uid="env.x.fslogixonthis" Style="{DynamicResource CardTitle}"/>
                    <TextBlock Uid="env.x.aftertheshare" Style="{DynamicResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Uid="env.x.mastertest" x:Name="BtnEnvMasterTest" Margin="0,0,8,0"/>
                        <Button Uid="env.x.masterapply" x:Name="BtnEnvMasterApply"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtEnvMaster" Style="{DynamicResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Grid>
