    "LeftoverTaskPatterns": [ "PilotOverlay", "Overlay", "^(GM|Golden)[-_ ]?(Master)?[-_ ]?(Setup|Prep|Logon|Startup)" ],
    "LeftoverPaths": [ "C:\\Drivers", "C:\\DriverBackup", "C:\\DriverExport", "C:\\ExportedDrivers", "C:\\ProgramData\\DriverExport" ],
    "LeftoverStarterFolder": "C:\\ProgramData",
    "LeftoverStarterFilter": "*.vbs",
    "PublicDesktopFolder": "C:\\Users\\Public\\Desktop",
    "PublicDesktopFilter": "*AVDTune*.lnk"
  },
